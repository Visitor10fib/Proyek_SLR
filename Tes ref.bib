@article{Sethanant2025,
   abstract = {In the past decade, six Mw ≥5.5 earthquakes struck the mountainous Golden Triangle region (Laos, Thailand, Myanmar) of the southeast India–Eurasia collision zone. The largest of them, the 2019 Mw 6.2 Sainyabuli earthquake in western Laos, shook river communities, dams and a UNESCO World Heritage Site, prompting a need to understand regional earthquake potential. We used Interferometric Synthetic Aperture Radar (InSAR) data and modelling to solve for the 2019 main shock source parameters, revealing right-lateral strike-slip along a 24 km-long NNW-trending fault which has limited topographic expression and was previously unmapped. InSAR modelling of its largest (Mw 5.5) aftershock in 2021 revealed a 7 km-long splay fault, also previously unrecognized. The 2022 Mw 5.9 Keng Tung earthquake in the northern Golden Triangle also ruptured an unknown, NW-trending right-lateral fault conjugate to longer, NE-trending faults nearby. Collectively, this shows that the region contains faults which are little evident in global digital topography and/or obscured by vegetation but long enough to generate sizeable earthquakes that should be accounted for in seismic hazard assessments. We relocated well-recorded aftershocks and other background seismicity (1978–2023) from across the Golden Triangle using the mloc software. Calibrated hypocentres span focal depths of 5–24 km and are distributed away from the main InSAR-modelled fault traces, another indication of fault structural immaturity. For the three 2019–2022 InSAR-constrained events, we also obtained moment tensor solutions from regional seismic waveform inversion. InSAR-derived peak slip depths and seismological centroid depths are mostly shallow (3–5 km), while focal depths are generally located in areas of low coseismic slip near the bottom of InSAR model faults. More broadly, we estimate a regional seismogenic thickness of ∼17 km (the 90 per cent seismicity cut-off depth), a crucial parameter for seismic hazard calculations and building codes. Our integration of remote-sensing and seismologic analyses could be a blueprint for assessing earthquake potential of other regions with sparse instrumentation and limited topographic fault expression. © The Author(s) 2025.},
   author = {I Sethanant and E Nissen and E Bergman and S J Oliva and L Pousse-Beltran and E Karasözen and P Pananont},
   doi = {10.1093/gji/ggaf061},
   issn = {0956540X (ISSN)},
   issue = {1},
   journal = {Geophysical Journal International},
   keywords = {Asia,Crustal structure,Earthquake effects,Earthquake engineering,Earthquake hazard,Earthquake hazards,Earthquake source observations,Fault slips,Geochronology,Hydrogeology,Interferometric synthetic aperture radars,Laos,Myanmar,Radar interferometry,Radar modeling,Religious buildings,Seismic hazards,Seismic response,Seismicity and tectonics,Strike-slip faults,Structural geology,Thailand,Windows,crustal structure,earthquake hypocenter,radar interferometry,satellite data,seismic hazard,seismic source,synthetic aperture radar},
