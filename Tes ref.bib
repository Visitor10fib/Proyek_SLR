@article{Jun2025,
   abstract = {The M7.1 earthquake happened in Yushu, Qinghai Province in 2010 had a devastating effect on life, property and s infrastructure in this region. The relationship between the Yushu Fault and landforms is still unclear, and there is no unified understanding of the activity characteristics of the Yushu Fault. Since geomorphic indices have the capacity to recognize the tectonic deformation from the landform, seven geomorphic indices were calculated by GIS hydrological analysis and spatial analysis, which are include mountain, front sinuosity index (Smf), river longitudinal profile, normalized stream gradient index (KSL), river steepness index (Ksn) in linear-scale and valley floor width-to-height ratio (Vi), basin f asymmetry factor (AF), hypsometric curve and integral (H) in spatial (watershed)-scale. Further, we analyzed the influence of climate, lithology, and tectonics on the landscape. We believe that active tectonics is the controlling factor in geomorphic evolution. According to the results of Smf and Vf, the uplift rate of Jielong Fault and Jiegu Fault were > 0.5 m/ky and 0.05 - 0.5 m/ky, respectively. Combining with field investigation, we pointed that the Jielong Fault is more active than the Jiegu Fault, so the activity of the Yushu Fault gradually increases from southeast to northwest in the study area. This study also demonstrated that the Longbao lake basin developed in an active tectonic setting with the structural control by two basin bounding faults. © 2025, Wadia Institute of Himalayan Geology. All rights reserved.},
   author = {W Jun and L Jiacun and Z Di},
