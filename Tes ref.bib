@article{Oviedo-Reyes2025,
   abstract = {This study explores the potential of logarithmic regressions of morphometric indices mountain front sinuosity (Smf) and valley floor width-to-height ratio (Vf) as a quantitative method to infer faulting styles from landscape morphology. We apply this approach to analyze the neotectonic fault kinematics of the Western Andean Front (WAF) in central Chile (35–37°S). Logarithmic regression of morphometric indices identifies two distinct faulting regimes:1) NW-striking faults, exhibiting a Vf-Smf relationship of Vf = 1.106Ln(Smf) + 0.0078, indicative of strike-slip to oblique faulting; and 2) NNE-striking faults, with Vf = 1.76Ln(Smf) + 0.346, consistent with bounding folded to reverse faulting. The Kolmogorov-Smirnov test confirms that these Smf/Vf patterns are statistically comparable to other tectonic settings worldwide. In parallel, we integrate structural analysis, including paleostress tensors derived from fault-slip data, to validate and refine the segmentation of neotectonic faults along the WAF. By comparing morphometric data with paleostress calculations, we observe that the morphometric derived interpretations align with key stress regimes, particularly the transition from strike-slip to compressional strike-slip along the internal mountain front between Ñuble and Maule regions (at 36°20′S). Analytically, the logarithmic regression lines and its first derivative provide insights into uplift rates and non-tectonics controls influencing the WAF. Overall, our analysis demonstrates that the Smf/Vf ratio is a reliable proxy for discerning faulting styles, offering valuable insights where subsurface data is scarce. The findings presented here enhance our understanding of fault kinematics in tectonically controlled fronts and provide important perspectives on how faulting styles leave a distinct geomorphic imprint on the landscape. © Elsevier Ltd},
   author = {J A Oviedo-Reyes and J Cortés-Aranda and A Fernández},
   doi = {10.1016/j.jsames.2024.105326},
   issn = {08959811 (ISSN)},
   journal = {Journal of South American Earth Sciences},
   keywords = {Andes,Chile,Kinematic proxy,Logarithmic regressions,Morphometric indices,Paleostress tensor,Western Andean front,faulting,geomorphology,morphometry,neotectonics,paleostress,regression analysis},
   note = {EID: 2-s2.0-85213838554
