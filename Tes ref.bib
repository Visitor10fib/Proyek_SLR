   issue = {1},
   journal = {Terrestrial, Atmospheric and Oceanic Sciences},
   keywords = {Coseismic displacement,DInSAR,Dapu earthquake,GNSS,Liquefaction,Seismic hazard assessment,Surface rupture,Taiwan,coseismic process,deformation,displacement,earthquake event,earthquake rupture,hazard assessment,liquefaction,seismic hazard,synthetic aperture radar},
   note = {EID: 2-s2.0-105003123113
