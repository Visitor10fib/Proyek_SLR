   issn = {1674487X (ISSN)},
   issue = {5},
   journal = {Journal of Earth Science},
   keywords = {Cenozoic,China,Laolongwan Basin,Northeastern Tibetan Plateau,Qinghai-Xizang Plateau,Riedel Shear,active fault,dating method,fault slip,fault slip rate,normal fault,remote sensing,shear,slip rate,strike-slip fault,structural geology,tectonic stress field,tectonics},
