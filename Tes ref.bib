   keywords = {Chaman fault,Earthquake engineering,Earthquakes,Fault mapping,Fault slips,Fault system,Fold-thrust belts,Geodynamics,Hazards,InSAR and seismic hazard,Interferometric synthetic aperture radar and seismic hazard,Interferometric synthetic aperture radars,Mapping,Neotectonics,Pakistan,Remote sensing,Seismic hazards,Seismic response,Strike-slip faults,Sulaiman Range,Sulaiman fold-thrust belt,active fault,fold and thrust belt,geological mapping,hazard assessment,neotectonics,seismic hazard,synthetic aperture radar},
