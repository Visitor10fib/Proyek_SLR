   issn = {0921030X (ISSN)},
   issue = {3},
   journal = {Natural Hazards},
   keywords = {Dammed lake,Dendrogeomorphology,Earthquake,Kazakhstan,Landslide,Sunken forest,Tree ring,dendrochronology,earthquake event,earthquake rupture,geomorphology,landslide,paleoseismicity,tree ring},
