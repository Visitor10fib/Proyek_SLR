@article{Xi2025,
   abstract = {Geomorphology along active faults reflect processes of tectonic-geomorphic interactions and their spatiotemporal evolution. A detailed geomorphic classification is an essential foundation for quantitative research on active faults. Previous geomorphic classification studies mainly use DEM terrain data. After determining geomorphic units at different scales, classification is performed using clustering, rule-based, and object-oriented methods. However, to achieve precise geomorphic type classification, both terrain differences and spectral characteristics are necessary considerations. In this paper, we combine hyperspectral data with DEM data to extract the spectral characteristic curves of different landforms(bedrock mountain areas, valleys, modern riverbeds, loess plateaus, and alluvial-proluvial fans). By incorporating five topographic factors elevation, slope, aspect, roughness, and topographic relief, we conducted a classification experiment using the Spectral Angle Mapper Classifier(SAM). This allowed for a precise delineation of geomorphological types within a 1 km buffer on both sides of the Shuaijialiang to Xiangcaogou section of the North Liulengshan Fault(39.5°~40.2°N, 113°~115°E). The results indicate that bedrock mountain areas and modern riverbeds are significantly distinguished in the 540~730 nm wavelength range. Slope and roughness are key factors in differentiating the boundaries between loess plateaus and alluvial-proluvial fans, with a total classification accuracy of 79.09 %. Additionally, within a 6 m buffer zone at the boundary between the loess plateau and alluvial-proluvial fan, 53 % of fault traces overlap, providing significant insights into the spatial distribution and geometric traces of active faults. This methodology effectively incorporates spectral feature information into the geomorphological classification of the North Liulengshan Fault region. It provides foundational geomorphological data for active fault mapping and can also serve as a reference for the delineation of structural geomorphological types in other areas. © 2025, Science China Press. All rights reserved.},
   author = {X Xi and Z Wei and J Zhao and S Geng and F Shi and J Zou and H He},
   doi = {10.11928/j.issn.1001-7410.2025.01.12},
   issn = {10017410 (ISSN)},
   issue = {1},
   journal = {Quaternary Sciences},
   keywords = {geomorphology classification,spectral angle classification,spectral characteristics,the North Liulengshan Fault,topographic factors},
