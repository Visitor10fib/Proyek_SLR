   journal = {Tectonics},
   keywords = {Atacama Desert,Catchments,Chile,Drainage reorganization,Fault slips,Forearc,Geomorphic mapping,Hydrogeology,Jurassic,Landscape evolutions,Mapping,Miocene,Neotectonics,Pliocene,Reorganisation,Strike-slip faults,Structural data,Structural geology,Tectonic forcing,discrete element method,drainage reorganization,geomorphic mapping,geomorphological mapping,landscape evolution,neotectonics,orogeny,satellite imagery,tectonic forcing,thrust fault,uplift},
