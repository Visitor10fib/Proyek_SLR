   journal = {Doklady Earth Sciences},
   keywords = {Active fault,Arc collisions,Arc-arc collision,Eocene,Fault slips,Geomorphology,Island arc,Jurassic,Kamchatka,Kamchatka Peninsula,Miocene,Northern Pacific,Northern pacific,Oceanography,Pacific Ocean,Pacific Ocean (North),Quaternary,Russian Federation,Structural geology,Subduction,Subduction zones,Topography,Volcanic belt,Volcanic rocks,Volcanism,Volcanoes,active fault,active faults,arc-arc collision,island arc,normal fault,plate tectonics,subduction,subduction zone,tectonic setting,tectonics,topographic effect,volcanic eruption,volcanism},
