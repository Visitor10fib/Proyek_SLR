@article{Wei2025,
   abstract = {The central Yunnan water diversion project is a crucial cross⁃regional water diversion initiative aimed at alleviating the resource⁃based water shortage in the central Yunnan region. The geological conditions along the project are complex and abyssal faults are developed. Determining the spatial variability of Holocene fractures and their segments in the project area has become one of the geological questions that need to be answered urgently in engineering investigations. In view of the shortcomings of traditional active fault survey, such as long period, low efficiency and poor outcrop representativeness, based on the tectonic geomorphology method, this study selected five geomorphological indicators as calculation factors, including hypsometric integral（HI）, drainage basin shape （BS）, asymmetry index（AF）, normalized stream⁃length gradient（SLK）and mountain front sinuosity（SMF）. We selected four Holocene faults developed along the basin to study the spatial difference of tectonic activity intensity, and discussed the influence of non⁃structural factors such as rainfall and lithology on the research results. At the same time, on the basis of field reconnaissance, the feasibility of the method is verified by the analysis of fault activity rate and seismic activity. The main conclusions are as follows: 1）the basins of each segment of the fault zone are in different stages of geomorphological evolution. The basins of F1⁃1 and F3⁃1 are relatively young, followed by the basins of F1⁃3, F2⁃1, F2⁃2 and F3⁃2, and the basins of F1⁃2, F2⁃3 and F4 are relatively old. 2）The intensity of tectonic activity of the four Holocene ruptures revealed by relative intensity of tectonic activity（Iat）is F1＞F3＞F2＞F4. In addition, F1 shows a strong north⁃south and weak center, F2 shows strong activity in the southern bedrock mountain section, and the basin part is weak, while F3 and F4 show moderate activity intensity and weak activity as a whole. Rainfall and lithology have no overall effect on the spatial distribution of Iat, with tectonic factors being the main factors. 3） Based on the tectonic geomorphology method, the relative tectonic activity intensity of the basin along the fault zone is consistent with the trend of activity rate and seismic activity, which confirms the feasibility of analyzing the spatial difference of fault activity intensity by relative tectonic activity intensity. It can be used to locate the active section of the structure, quickly determine the typical outcrop, and improve the survey efficiency. © 2025 Science Press. All rights reserved.},
   author = {Y Wei and S Chen and X Wang and J Wang and C Jin and S Guo and Z Li and Y Tian},
   doi = {10.12017/dzkx.2025.019},
   issn = {05635020 (ISSN)},
   issue = {1},
   journal = {Scientia Geologica Sinica},
   keywords = {Central Yunnan water diversion project,China,Holocene,Holocene fault,Relative intensity of tectonic activity,Spatial variability,Tectonic geomorphology,Yunnan,active fault,basin evolution,bedrock,drainage basin,fault zone,geomorphology,hydraulic structure,lithology,outcrop,rainfall,rupture,spatial distribution,spatial variation,tectonics},
