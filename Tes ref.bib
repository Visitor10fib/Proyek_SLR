   journal = {Geotectonica et Metallogenia},
   keywords = {Active fault,Bay areas,Coastal zones,Disaster prevention,Earthquakes,Fault slips,Fault zone,Geological hazards,Global positioning system,Guangdong-Hong Kong-Macao Greater Bay Area,Guangdong-hong kong-macao great bay area,Hazards,Hong-kong,Littoral Fault Zone,Littoral fault zone,Littorals,Marine active fault,Marine geological hazard,Miocene,Offshore oil well production,Remote sensing,Seismic response,Slope Fault Zone,Slope fault zone,Strike-slip faults,Submarine geology,marine active fault,marine geological hazard},
