   keywords = {Activity age,Basin boundary,Cenozoic,China,Disaster prevention,Disasters,Exploratory boreholes,Fault slips,Geochronology,Geological structures,Geological surveys,Hydrogeological,Jinzhong,Jurassic,Landforms,Late Pleistocene,Loess Plateau,Middle Pleistocene,Miocene,Pleistocene,Quaternary,Remote sensing,Rural areas,Sediments,Segmentation,Seismic prospecting,Seismic safety assessments,Seismology,Shanxi,Strike-slip faults,Structural geology,Taigu,Taiyuan,Taiyuan Basin,Urban areas,Urban planning,Wanghu Fault,Wanghu fault,Yuci,activity age,basin boundary,borehole geophysics,dating method,fault displacement,fault zone,geological structure,gravity anomaly,normal fault,segmentation,seismic hazard,spatial distribution,tectonic evolution,urban area,urban planning},
   note = {EID: 2-s2.0-105022486903
Export Date: 25 September 2026
Cited By: 0
Correspondence Address: J.-Y. Zeng; Shanxi Earthquake Agency, Taiyuan, 030002, China; email: 13903412202@163.com},
   pages = {1167-1182},
   publisher = {Editorial Office of Dizhen Dizhi},
   title = {STUDY ON THE QUATERNARY ACTIVITY CHARACTERISTICS AND TECTONIC SIGNIFICANCE OF THE WANGHU FAULT IN TAIYUAN BASIN},
   volume = {47},
   url = {https://www.scopus.com/pages/publications/105022486903?origin=resultslist},
   year = {2025}
