@article{Zhang2025,
   abstract = {The Pamir Plateau is a key area in the global research on the basic theoretical issues of earth science, such as plate collision and basin-mountain coupling process, interplate deformation and tectonic morphology, active tectonics and modern earthquakes, crust-mantle structure and dynamic evolution. In recent years, a series of medium-high temperature geothermal fields and a well with mixed water vapor temperature of 144 ℃ have been discovered in Tashkent Valley, northeast margin of Pamir Plateau, pushing the geothermal research in this area to a new stage of development. Based on the the third Xinjiang comprehensive scientific expedition on geothermal science and the data of geothermal survey and drilling during 2010— 2024, thermal-rheological structure of the lithosphere mantle of the Pamir Plateau and the crustal temperature structure of its northeast margin have been calculated by seismic shear wave data, gravity potential spherical harmonic coefficient and magnetic anomaly spectrum analysis. It provides the basis for theoretical geothermal research and exploitation of geothermal resources in this area. The results show that the average temperature of the mantle at 100 km depth is 1250 ℃, and the average temperature at 200 km depth is 1540 ℃. At a depth of 200 km, mantle temperature rises rapidly, which is the main area of mantle convective activity. The tangential stress field of the mantle flow at the depth of 200 km shows an alternate pattern of extrusion and tension, which is the main reason for the formation of the compression-left-lateral strike-slip tectonic domain on the west side, the compression-right-lateral strike-slip tectonic domain on the north side and the extension-right-lateral strike-slip tectonic domain on the northeast margin of the Pamir Plateau. The mean temperature of the Moho surface in the northeast margin is 1078 ℃, which will lead to the pure shear mode of the lithosphere. In the integrated geophysical inversion section across the Taxian Basin, Quman geothermal field and Tashkent fault, there is a high temperature zone with a center temperature of 1200 ℃ under the Moho of Taxian Basin. There is a Vp/Vs low value region above the high temperature region, which is distributed in a vertical column and is a high temperature and high porosity region. The deep active hydrothermal fluid can reach the Curie isothermal surface along the ascending channel on the west side of this area, and then, rise along the main active structures in the extension-right-lateral strike-slip tectonic domain, and exchange heat with the shallow surface groundwater to form a hot spring. We believe that the active normal fault in the northeast margin of Pamir Plateau is the important conditions for groundwater infiltration, heat exchange and geothermal resources formation. The exchange depth of cold and hot water in this area is shallow, and there is no geothermal geological condition of geothermal water heating along the deep circulation of faults. The exploration of deep geothermal resources or dry hot rock in this area needs to focus on the “plume” high-temperature hydrothermal activity from the mantle. © 2025 Editorial Office of Chinese Journal of Geophysics. All rights reserved.},
   author = {J Zhang and Y Kong},
   doi = {10.6038/cjg2024S0451},
   issn = {00015733 (ISSN)},
   issue = {1},
   journal = {Chinese Journal of Geophysics},
   keywords = {Crust mantle,Crust-mantle temperature structure,Earthquakes,Fault slips,Geochronology,Geomorphology,Geothermal fields,Geothermal prospecting,Geothermal wells,Glaciers,Gold deposits,Hydrogeology,Hydrothermal activity,Landforms,Lithology,Mantle flow,Mantle flow stress field,Mantle hydrothermal activity,Mantle temperatures,Moho,Pamir Plateau,Pamir plateau,Pamirs,Quman geothermal field,S-wave,Shear bands,Silt,Stress field,Strike-slip faults,Structural geology,Tashkent,Temperature structure,Uzbekistan,Watersheds,continental collision,crust-mantle boundary,crustal deformation,extensional tectonics,fault zone,high temperature,hydrothermal activity,hydrothermal fluid,lithosphere,magnetic anomaly,normal fault,porosity,rheology,stress field},
   note = {EID: 2-s2.0-85215694792
