   keywords = {Coseismicsurface deformation,Deformation zone,Dengmocuo Fault,Dengmocuo fault,Digital surface model,Digital surface model (DSM),Digital surface models,Dingri earthquake,Earthquakes,Fault slips,GaoFen - 7 imagery (GF - 7),Gaofen - 7 imagery,High-precision,Image segmentation,Lakes,Microseismic monitoring,Remote sensing,Surface-deformations,Vertical deformation,coseismicsurface deformation,earthquake},
