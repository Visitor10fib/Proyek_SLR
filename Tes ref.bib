@article{Jalal2025,
   abstract = {Understanding the geographical distribution of lineaments is essential for determining tectonic interest and its consequences for geomorphology, hydrology, and natural resource management. The Digital Elevation Model is used to create hillshade images to extract the lineaments, analyze their orientation, and perform density mapping using ArcGIS Pro and Rockworks 16 software. 207 and 507.28 Km is the total number and length of lineaments, respectively, with lineament numbers of the NW-SE direction constituting 42% and 48.814% of the total length. This dominant orientation aligns with the Badrah-Amarah fault at the same time, reflecting tectonic uplift from Arabian-Eurasian plate collision. The high-density lineament and lineament-network intersections are concentrated in the northeastern part of the region. They are primarily associated with active fault zones, significant structural deformation, and ongoing neotectonic activity. These high-density sites are associated with fluid flow paths and groundwater recharge zones, which may indicate gas or hydrocarbon accumulating sites. Furthermore, a strong relationship existed between the high lineament density and disturbed stream networks, which then revealed that lineament-controlled river deviations result from active compression pressures. The above observations give crucial insights into evaluating tectonic activity, seismic hazard evaluation, hydro-geological investigations, resource exploration, environmental planning, and understanding the geomorphology of the studied region. © 2025, Union of Iraqi Geologists. All rights reserved.},
   author = {G K Jalal and A K Al-Ali and R M Amin},
   doi = {10.46717/igj.2025.58.2D.6},
   issn = {24146064 (ISSN)},
   issue = {2},
   journal = {Iraqi Geological Journal},
   keywords = {DEMs,Drainage Pattern,Hillshade images,Iraq,Lineament,Remote sensing,Zurbatiyah},
   note = {EID: 2-s2.0-105022192249
Export Date: 25 September 2026
Cited By: 2},
   pages = {77-89},
   publisher = {Union of Iraqi Geologists},
   title = {Neotectonics Activity Evaluation and Structural Deformation in Zurbatiyah Area, Eastern Iraq: GIS-Based Lineament Analysis Approach},
   volume = {58},
   url = {https://www.scopus.com/pages/publications/105022192249?origin=resultslist},
   year = {2025}
}
@inproceedings{Li2025,
   abstract = {Based on the C-band SAR data of the Sentinel-1A satellite in ascending and descending orbits, the differential interferometry (D-InSAR) technique was used to extract the coseismic surface deformation field of the Luding earthquake, and then the fault geometric parameters and slip distribution were jointly inverted. The results show that: (1) The maximum LOS deformation of the ascending coseismic deformation field is -0.197m, and the maximum LOS deformation of the descending deformation field is -0.132m. The strike of the seismogenic fault is NNW. (2) The inversion results show that the fault plane strikes about 168°, dips 78°, slips -3.5°, and has a maximum slip of about 2.2 m, indicating that the rupture type is left-lateral strike-slip. © COPYRIGHT SPIE. Downloading of the abstract is permitted for personal use only.},
