   journal = {Dizhen Dizhi},
   keywords = {China,Dip angle,East segment of eastern tianshan,Eastern Tianshan,Eastern segment of the northern margin fault of the hami basin,Fault fracture zones,Faulting,Geological surveys,Geomorphology,Harlik Mountains,Holocene,Holocenes,Landforms,Late Pleistocene,Late pleistocene activity,Late quaternary,Location,Microtremors,Remote sensing,Shear flow,Shear waves,Structural geology,Xinjiang Uygur,active fault,east segment of eastern Tianshan,eastern segment of the Northern Margin Fault of the Hami Basin,fault zone,fracture geometry,fracture zone,integrated approach,late Pleistocene activity,microtremor,slip rate},
