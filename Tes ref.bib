   issue = {1},
   journal = {Natural Hazards},
   keywords = {Active fault system,Mexico [North America],Michoacan,Morelia,Neotectonics,Seismic hazard,Trans-Mexican Volcanic Belt,Trans-mexican volcanic belt,active fault,displacement,earthquake magnitude,fault zone,neotectonics,seismic hazard,seismic source,slip rate,volcanic belt},
