   editor = {M Ozaslan},
   isbn = {26023199 (ISSN); 978-625695971-2 (ISBN)},
   booktitle = {Eurasia Proceedings of Science, Technology, Engineering and Mathematics},
   keywords = {Drones,Geospatial hazard modelling,Overlay analysis,Renewable energy risk assessment},
