@article{Li2025,
   abstract = {The Yalong River is featured with high-relief, narrow river gorges and steep slopes, causing serious landslide hazards, which is situated on the eastern margin of the Tibetan Plateau with the latitude from 26.6°N to 34.2°N and the longitude from 96.8°E to 102.7°E, covering an area of 1.28×105 km2. This study aims to investigate the distribution features and controlling factors of large landslides in the Yalong River basin. A comprehensive landslide database was firstly established through a combination of field observations and high-resolution satellite imagery analysis. Based on this database, typical landslide types and failure patterns then can be identified and analyzed. At the same time, by using GIS spatial clustering and statistical methods, the underlying distribution patterns and concentration areas of landslides were uncovered, and the relationships between landslide occurrence and various factors were examined, including topography, active faults, seismicity, and precipitation. Our results revealed that at least 732 large landslides were developed within the Yalong River basin, with the feature of inhomogeneous spatial distribution. Majority of these landslides are concentrated in the middle segment of the Yalong River with the high mountainous canyon. Notably, large landslides are mainly distributed along the active fault zone and the river banks, exhibiting strong spatial clustering. The majority of landslides being concentrated at the elevation of 2000~3500 m, the slope of 20°~40°, the dominant dipping direction of southwest, south and southeast, and the topographic relief of 400~600 m. Large landslides tend to be concentrated in the areas with relative hard rock mass, including shale, dolomite, and carbonate rocks. The distance to fault is also a significant influencing factor, with landslides being mainly distributed in the area within 1000 m of active faults. Furthermore, our analysis revealed that landslide distribution is strongly correlated with seismic activity and heavy rainfall. Four landslide concentration areas(J1~J4) in the Yalong River basin were identified by kernel density estimation. Among them, the J3 (0.02 number/km2) and J4 (0.018 number/km2) areas are located in the middle segment of the Yalong River, exhibiting the highest density of landslides. The spatial distribution of landslides is closely related to the active fault, and we delineated five landslide clustering areas(H1~H5) that are strongly affected by active faults. Among them, the H2 area exhibits the most concentrated landslide distribution, where 105 large landslides were in a linear pattern along the Xianshui River fault zone. According to filed investigation, the failure patterns of landslides in this area can be classified into three types: the tensile cracking-sliding, the sliding-bending and the toppling, which are influenced by various factors including bedding orientation, main structural planes, and slope characteristics. The results presented in this study provide valuable insights into the spatial distribution and formation mechanisms of large landslides in the Yalong River basin, which is helpful for landslide hazard prevention and mitigation in this region. © 2025, Science China Press. All rights reserved.},
   author = {C Li and X Su and Y Wang and S Ma and L Gao and R Yuan},
   doi = {10.11928/j.issn.1001-7410.2025.01.11},
   issn = {10017410 (ISSN)},
   issue = {1},
   journal = {Quaternary Sciences},
   keywords = {Yalong River basin,distribution features,failure patterns,formation mechanisms,large landslides},
   note = {EID: 2-s2.0-86000653857
