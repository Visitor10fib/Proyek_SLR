@article{Hao2025,
   abstract = {Tight sandstone typically has a limited distribution of sandbodies, which are poorly connected and highly heterogeneous in physical properties. Even in some areas, the sandstone reservoirs contain microfractures and high water content. Such tight sandstone reservoirs with high water content and microfractures cannot be exploited by common exploration and development technologies for unconventional reservoirs. These high-water-content tight sandstone reservoirs are challenged by lateral sandbody variation, strong heterogeneity, difficult sweet spot prediction by seismic data, and other issues impeding the efficient development possibly induced by the presence of microfractures and horizontal well volume fracturing treatment. Taking the high-water-content tight sandstone reservoirs of Jurassic Sangonghe Formation in the Ji-7 block, Qiudong sag, Tuha Basin, as an example, fractures and sweet spots are finely predicted by carrying out the geology–seismic integration idea, using the drilling/ completion, production test and latest seismic data, and through the analysis of factors controlling the hydrocarbon enrichment in tight sandstone. The following results are obtained. First, the influencing factors of sweet spots are clarified by a systematic analysis on the factors controlling the hydrocarbon enrichment in tight sandstone in the study area. Combining with production test and drilling/completion data, the controls of sweet spots and fractures on the enrichment of tight oil/gas are determined. Second, based on the existing knowledge from exploration operations, the favorable fracture zones are predicted using newly acquired 3D seismic data, by a method based on multi-attribute fusion, and with consideration to coherence, curvature and maximum likelihood attributes. It is found that fractures are developed in strike-slip fault and bulge zones, and distribute in en echelon pattern. Third, based on reservoir evaluation, fracture prediction, and seismic attribute analysis, the tight oil/gas sweet spot zones are identified and characterized, and the distribution of favorable zones is defined. The area to the south of Well Ji 10H is proposed as a favorable zone for future exploration. It is concluded that the proposed method for predicting hydrocarbon enrichment and sweet spots in high-water-content tight sandstone reservoirs based on geology–seismic integration is a crucial technique for tight oil/gas development, and can provide useful guidance and reference for efficient and scale development of tight oil and gas reservoirs with high water content and microfractures in other areas. © 2025 Natural Gas Industry Journal Agency. All rights reserved.},
   author = {W Hao and X Sun and J Lian and Y Han and J Zhang and Z Li and Z Cheng and Y Yuan and L Sun},
