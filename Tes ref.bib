@article{Yilmaz2025,
   abstract = {We performed a 3-D AI-based structural interpretation of a seismic image volume derived from 3-D prestack time migration, and delineated fault geometries and the subsidiary Riedel shear fractures within the sedimentary overburden associated with the North Anatolian Fault System (NAFS) in the western half of Marmara Basin, Türkiye. We thus inferred existence of dextral strike-slip basement fault segments with extensional (releasing) and contractional (restraining) stepovers that gave rise to the formation of the geomorphic features — the pull-apart Tekirdağ and Central Basins, and the Western High pop-up structure, respectively. The NAFS shear zone within the study area extends E-W and has a 20-km maximum N-S width. Previous investigations based on 3-D inversion of gravity data over the Sea of Marmara and the surrounding region, and long-range E-W seismic refraction profiling across the basin infer that the Moho depth is as shallow as 24 km in the western half of Marmara Basin — nearly 6 km shallower than the average regional depth of 30 km. The Moho uplift forms a fairly narrow ridge (<30 km) confined to the NAFS shear zone, coincident with the E-W principal strike direction of the NAFS. This implies that it may have been formed contemporaneously with the formation of the pull-apart basins which gave rise to crustal stretching within the stepovers, resulting in basin subsidence, crustal thinning, and Moho uplift. The segmentation in the NAFS and the E-W trending Moho ridge may have led to the formation of earthquake rupture barriers and weak zones in the brittle upper crust. © 2025 Elsevier B.V.},
   author = {Ö Yilmaz and Z Özer and D T Beşevli and J E L Wu and C Özsoy and S Sevinç and K B Bakioglu and M B Ercengiz and Ö K Şahin and B Dadak and T Hastürk and Ö Yapar and H Dalabasmaz and N Ö Sipahioglu and C Demirci and R Ö Temel and M F Akalın and M S B Sadioglu},
   doi = {10.1016/j.tecto.2025.230726},
   issn = {00401951 (ISSN)},
   journal = {Tectonophysics},
   keywords = {3-D AI fault interpretation of 3-D PSTM image volume,3-D gravity inversion to delienate the Moho geometry,3-D gravity inversion to delienate the moho geometry,Basement strike-slip fault segment,Basement strike-slip fault segments,Correlation of earthquake hypocenter with fault segment,Correlation of earthquake hypocenters with fault segments,Earthquakes,Fault interpretation,Fault slips,Geochronology,Geomorphology,Gravity inversions,Hydrogeology,Hypocentre,Image volume,Marmara [Turkey],Moho,Riedel shear fracture,Riedel shear fractures,Shear flow,Shear fracture,Strike-slip faults,Structural geology,Turkey,Window screens,artificial intelligence,crustal thinning,data inversion,earthquake rupture,fault geometry,overburden,prestack migration,pull apart basin,segmentation,seismic discrimination,seismic refraction,shear zone,strike-slip fault,subsidence,uplift,upper crust},
