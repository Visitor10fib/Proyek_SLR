Cited By: 0
Correspondence Address: Y.-M. Wen; School of Geodesy and Geomatics, Wuhan University, Wuhan, 430079, China; email: ymwen@sgg.whu.edu.cn},
   pages = {1292-1305},
   publisher = {Editorial Office of Dizhen Dizhi},
   title = {SEISMOGENIC STRUCTURE OF THE DINGRI M₩5.7 EARTH-QUAKE OF MARCH 20, 2020 (SOUTHERN QINGHAI-XIZANG PLATEAU) CONSTRAINED BY THE COSEISMIC AND POSTSEISMIC DEFORMATION},
