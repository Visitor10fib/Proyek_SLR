}
@article{Li2025,
   abstract = {In October 2023, four MW6.3 thrust earthquakes occurred consecutively in the seismic gap in northwest Afghanistan and the seismogenic fault is still unclear. This article comprehensively analyzed the InSAR deformation and focal mechanism solutions, and believes that the Afghanistan earthquake swarm mainly occurred on two faults. The InSAR deformation data was used to determine their positions, strike, dip and other parameters. The strike, dip and rake of the first fault are 278.15°, 40.76° and 106.99° respectively. The strike, dip and rake of the second fault are 240.08°, 37.46° and 63.32° respectively. The two faults are stacked together in a “V” shape at a certain angle, with thrust slip as the main mode of rupture. The first fault has a right-strike slip component, while the second fault has a left-strike slip component, which are consistent with the focal mechanism solutions of the earthquake swarm. The pushing of the Arab Plate and the Indian Plate on the Eurasian Plate (the directions of the pushing forces also intersect in a “V” shape) is the main driving source for the stress accumulation of the Afghanistan earthquake swarm. The source slip distribution indicate that the rupture of Afghanistan earthquake swarm did not break the surface, with a maximum slip of 2.24 m and a total seismic moment of ~1.3 × 1019 N·m (MW6.66), which is equivalent to the total seismic moment released by earthquakes with MW≥5.5 in the swarm. The source slip distribution in space has a good correspondence with the focal mechanism solutions determined by GCMT. This article believes that the second MW 6.3 earthquake in the swarm occurred on the first fault, and the other three occurred on the second fault. The first earthquake in the swarm has the ability to trigger the second earthquake, and the second earthquake has promoting effect on the third and fourth earthquake. It′s currecntly diffcult to determine whether the earthquake has enden. The Coulomb stress changes caused by the swarm can promote the slip of the Herat fault, and its seismic hazard needs to be considered. © 2025 Science Press. All rights reserved.},
   author = {Q Li and C Li and G Liu and M Lin and Y Zhang},
   doi = {10.6038/cjg2024S0041},
   issn = {00015733 (ISSN)},
   issue = {10},
   journal = {Chinese Journal of Geophysics},
   keywords = {Afghanistan,Afghanistan earthquake swarm,Coulomb criterion,Coulomb stress change,Coulomb stress changes,Earthquake swarms,Earthquakes,Fault slips,Focal mechanism,Herat,Interferometric Synthetic Aperture Radar,Interferometric synthetic aperture radars,Interferometry,Miocene,Remote sensing,Slip distribution,Source slip distribution,Strike-slip component,Strike-slip faults,Synthetic aperture radar,V-shape,deformation mechanism,earthquake magnitude,earthquake rupture,earthquake swarm,focal mechanism,seismic hazard,seismic moment,slip rate,synthetic aperture radar,thrust},
