@inproceedings{Zhang2025,
   abstract = {The Mianshan fault is an important active fault within the Fen-Wei River fault zone. Located between the Taigu fault and the Huoshan fault, it spans approximately 45 kilometers and belongs to the late Pleistocene active fault. Through geological surveys, geophysical exploration, and seismological analysis, the author has redefined the geometric spatial distribution of the fault. The research results indicate that the northern end of the fault can extend to the south of Hongshan Village in Jiexiu City. After extending northward, the fault runs through the Taigu fault and the Huoshan piedmont fault from north to south. Through seismological analysis, the author has provided the seismic hazard analysis results of the fault, indicating that there is a potential seismic hazard of magnitude 6.8 in the future. The research results have important reference significance for understanding the seismotectonic background and potential seismic source areas of the Taiyuan Basin and Linfen Basin. Copyright © (2026) by Aussino Academic Publishing House All rights reserved.},
